# Copia este archivo como ".env" y rellena tus valores antes de hacer
# "docker compose up". Docker Compose lo lee automáticamente.

# --- Base de datos ---
POSTGRES_USER=miriam
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=miriam_campos

# --- Clave del panel privado (/admin) ---
ADMIN_KEY=elige-una-clave-larga-y-unica

# --- Correo saliente (SMTP; déjalo vacío para probar sin envíos reales) ---
SMTP_PASS=
PHOTOGRAPHER_EMAIL=tu@correo.com
